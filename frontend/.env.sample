# Скопируй в .env: cp .env.sample .env  (в папке frontend/)
# Для Vite обязателен префикс VITE_

# Тот же App ID, что и INSTAGRAM_CLIENT_ID в backend/.env
VITE_INSTAGRAM_CLIENT_ID=1816087969564941
# Должен 1-в-1 совпадать с INSTAGRAM_REDIRECT_URI в backend/.env
VITE_INSTAGRAM_REDIRECT_URI=http://localhost:5173/auth/instagram/callback
# Куда фронт стучится за API
VITE_BACKEND_URL=http://localhost:5000